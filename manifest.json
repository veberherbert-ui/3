{
  "manifest_version": 3,
  "name": "Авито Парсер для риэлтора",
  "version": "1.0.0",
  "default_locale": "ru",
  "description": "Умный фильтр объявлений на Avito: ключевые слова, слова-исключения, только собственники, диапазон цены, экспорт списка в CSV.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://www.avito.ru/*",
    "https://avito.ru/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Авито Парсер"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.avito.ru/*",
        "https://avito.ru/*"
      ],
      "js": ["src/parser.js", "src/content.js"],
      "css": ["src/panel.css"],
      "run_at": "document_idle"
    }
  ]
}
