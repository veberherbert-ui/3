{
  "name": "iron-diary",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Железный дневник — трекер силовых тренировок, работает офлайн",
  "scripts": {
    "dev": "vite",
    "check": "node tools/check-data.mjs",
    "build": "node tools/check-data.mjs && vite build && node tools/check-build.mjs",
    "preview": "vite preview",
    "smoke": "node tools/smoke.mjs && SMOKE_DEVICE=\"Galaxy S8\" node tools/smoke.mjs",
    "smoke:ios": "node tools/smoke.mjs",
    "smoke:android": "SMOKE_DEVICE=\"Galaxy S8\" node tools/smoke.mjs",
    "icons": "node tools/make-icons.mjs",
    "shots": "node tools/shots.mjs",
    "smoke:webkit": "SMOKE_ENGINE=webkit node tools/smoke.mjs",
    "smoke:firefox": "SMOKE_ENGINE=firefox node tools/smoke.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/veberherbert-ui/3.git"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "jsqr": "^1.4.0",
    "playwright": "1.56.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0"
  },
  "browserslist": [
    "safari >= 14.1",
    "ios_saf >= 14.5",
    "chrome >= 88",
    "firefox >= 78",
    "edge >= 88",
    "not dead"
  ]
}
