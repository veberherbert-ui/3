// Настройки раздачи для Cloudflare Workers.
//
// Приложение — только статика: собранный Vite-проект в dist/. Своего кода
// на стороне сервера нет, поэтому нет и поля "main": Worker целиком состоит
// из файлов сборки.
//
// Без этого файла сборка проходит, а выкладка падает на
// «Missing entry-point to Worker script or to assets directory» —
// wrangler не знает, что именно выкладывать.
{
  // Должно совпадать с именем проекта в Cloudflare: отсюда берётся адрес
  // 3.veberherbert.workers.dev
  "name": "3",
  "compatibility_date": "2026-08-14",
  "assets": {
    "directory": "./dist"

    // not_found_handling намеренно оставлено по умолчанию. Режим
    // single-page-application отдаёт index.html на любой неизвестный адрес
    // со статусом 200 — и телефон со старой версией, запросивший исчезнувший
    // файл сборки, получит вместо ошибки страницу и не сможет её прочитать.
    // Своих адресов у приложения нет, всё живёт на одной странице,
    // так что подменять 404 незачем.
  }
}
